[Unit]
Description=Vinoth OS FastAPI
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/opt/vinoth-os
Environment="VINOTH_OS_DATA_DIR=/opt/vinoth-os/data"
Environment="TIMEZONE=America/New_York"
ExecStart=/opt/vinoth-os/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
